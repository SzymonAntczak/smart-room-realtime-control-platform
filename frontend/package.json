{
    "name": "@smart-room/frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "lint": "eslint ../frontend --config ../eslint.config.js",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "build": "tsc --noEmit && vite build",
