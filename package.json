{
    "name": "smart-room-realtime-control-platform",
    "private": true,
    "type": "module",
    "workspaces": [
        "backend",
        "frontend",
        "shared",
        "simulator"
    ],
    "scripts": {
        "dev": "node scripts/dev-system.mjs",
        "dev:backend": "npm run dev --workspace @smart-room/backend",
        "dev:frontend": "npm run dev --workspace @smart-room/frontend",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "lint": "eslint .",
        "test:backend": "npm run test --workspace @smart-room/backend",
        "test:frontend": "npm run test --workspace @smart-room/frontend",
        "test:contracts": "npm run test --workspace @smart-room/contracts",
        "test:simulator": "npm run test --workspace @smart-room/simulator",
        "typecheck": "npm run typecheck --workspace @smart-room/contracts && npm run typecheck --workspace @smart-room/backend && npm run typecheck --workspace @smart-room/frontend && npm run typecheck --workspace @smart-room/simulator"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.60.1"
    }
}
