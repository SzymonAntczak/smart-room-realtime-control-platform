{
    "name": "smart-room-realtime-control-platform",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.15 <25"
    },
    "workspaces": [
        "backend",
        "frontend",
        "frontend-e2e",
        "shared",
        "simulator"
    ],
    "scripts": {
        "dev": "node scripts/dev-system.mjs",
        "dev:backend": "npm run dev --workspace @smart-room/backend",
        "dev:frontend": "npm run dev --workspace @smart-room/frontend",
        "format": "prettier --check .",
        "format:files": "prettier --check",
        "format:write": "prettier --write .",
        "lint": "eslint .",
        "lint:files": "eslint",
        "test:backend": "npm run test --workspace @smart-room/backend",
        "test:frontend": "npm run test --workspace @smart-room/frontend",
        "test:contracts": "npm run test --workspace @smart-room/contracts",
        "test:codex-hooks": "node --test scripts/codex-verify.test.mjs",
        "test:simulator": "npm run test --workspace @smart-room/simulator",
        "typecheck": "npm run typecheck --workspace @smart-room/contracts && npm run typecheck --workspace @smart-room/backend && npm run typecheck --workspace @smart-room/frontend && npm run typecheck --workspace @smart-room/simulator && npm run typecheck --workspace @smart-room/frontend-e2e",
        "test:backend:unit": "npm run test:unit --workspace @smart-room/backend",
        "test:backend:integration": "npm run test:integration --workspace @smart-room/backend",
        "test:frontend-e2e": "npm run test --workspace @smart-room/frontend-e2e --",
        "test:frontend-e2e:compiler": "npm run test:compiler --workspace @smart-room/frontend-e2e --",
        "test:frontend-e2e:unit": "npm run test:unit --workspace @smart-room/frontend-e2e --",
        "typecheck:frontend-e2e": "npm run typecheck --workspace @smart-room/frontend-e2e --",
        "install:frontend-e2e": "npm run install:browser --workspace @smart-room/frontend-e2e --"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "tsx": "^4.23.1",
        "typescript-eslint": "^8.60.1",
        "vitest": "^4.1.8"
    }
}
