{
    "name": "smart-room-realtime-control-platform",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev-system.mjs",
        "dev:backend": "npm --prefix backend run dev",
        "dev:frontend": "npm --prefix frontend run dev",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "lint": "eslint .",
        "test:backend": "npm --prefix backend run test",
        "test:frontend": "npm --prefix frontend run test",
        "test:simulator": "npm --prefix simulator run test",
        "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck && npm --prefix simulator run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.60.1"
    }
}
